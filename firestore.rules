rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }

    // Publiczny ekran jadłospisu wymaga wyłącznie odczytu.
    match /menu/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Dane klientów, tras i kierowców są dostępne tylko w panelu administratora.
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
