# Wygeneruj losowe wartości, np. `openssl rand -base64 48`.
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
DRIVER_SESSION_SECRET=replace-with-a-long-random-secret

# Dane konta usługi Firebase (server-side only).
FIREBASE_ADMIN_PROJECT_ID=your-firebase-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
# Jedna linia; nowe wiersze klucza zapisz jako \n.
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"
